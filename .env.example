# Frontend (Vite public vars - safe for client bundle)
VITE_API_BASE_URL=http://localhost:8787
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Worker (server-only secrets - NEVER expose to client)
CLERK_SECRET_KEY=your_clerk_secret_key_here
# Optional Clerk JWT verification key for deployed verification.
CLERK_JWT_KEY=your_clerk_jwt_key_here
# Exact comma-separated frontend origins; required in deployed environments.
# Wildcards are rejected. This is server-side only.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# VPS LFM service (server-only; never use VITE_* names).
VPS_LFM_BASE_URL=https://vps-llm.example.internal
VPS_LFM_API_KEY=replace_with_server_secret
VPS_LFM_MODEL=lfm2.5-1.2b

# Optional Cloudflare AI Search configuration. AI_SEARCH is a Wrangler binding,
# not a client environment variable. Local curated RAG is used when absent.
AI_SEARCH_INSTANCE=underwriting-knowledge
